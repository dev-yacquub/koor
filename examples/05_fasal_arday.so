# 05_fasal_arday.so - Qaab-dhismeedka Shayga (OOP - Classes & Objects)
# ===================================================================

# Qaybta Aasaasiga ah (Base Class): Qof
fasal Qof:
    hawl __init__(self, magac, da):
        self.magac = magac
        self.da = da

    hawl is_bar(self):
        celi f"Magacaygu waa {self.magac}, waxaanan jiraa {self.da} sano."

# Qaybta Dhaxlaysa (Inherited Class): Arday
fasal Arday(Qof):
    hawl __init__(self, magac, da, fasalka, takhasus):
        super().__init__(magac, da)
        self.fasalka = fasalka
        self.takhasus = takhasus
        self.buundooyinka = []

    hawl ku_dar_buundo(self, buundo):
        self.buundooyinka.append(buundo)

    hawl celcelis(self):
        haddii ma self.buundooyinka:
            celi 0
        celi isku_dar(self.buundooyinka) / dherer(self.buundooyinka)

    hawl warbixin(self):
        celi (
            f"--- Warbixinta Ardayga ---\n"
            f"Magaca:    {self.magac}\n"
            f"Da'da:     {self.da}\n"
            f"Fasalka:   {self.fasalka}\n"
            f"Takhasus:  {self.takhasus}\n"
            f"Celcelis:  {self.celcelis():.2f}"
        )


# Tijaabada Fasalka
arday_1 = Arday("Sahra Cabdi", 19, "Sanadka 2aad", "Sayniska Kombuyuutarka")
arday_1.ku_dar_buundo(94)
arday_1.ku_dar_buundo(88)
arday_1.ku_dar_buundo(91)

daabac(arday_1.is_bar())
daabac("")
daabac(arday_1.warbixin())
