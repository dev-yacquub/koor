# 01_salaan.so - Barnaamijkii ugu Horreeyey ee SoomaaliPy
# ====================================================

magac = "Cali"
da = 20
magaalo = "Muqdisho"

daabac("🌟 Soo dhawoow dunida SoomaaliPy!")
daabac(f"Magacaygu waa {magac}, waxaan jiraa {da} sano, waxaan degganahay {magaalo}.")

# Xisaab fudud
qiimo_1 = 15
qiimo_2 = 25
wadar = qiimo_1 + qiimo_2

daabac(f"Wadarta {qiimo_1} iyo {qiimo_2} waa: {wadar}")

# Hubin xaalad (if/else)
haddii wadar > 30:
    daabac("Wadartu way ka weyn tahay 30!")
kale:
    daabac("Wadartu ma gaarsiisna 30.")
