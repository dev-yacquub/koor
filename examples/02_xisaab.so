# 02_xisaab.so - Hawlo iyo Xisaabaad
# ====================================================

# Hawl xisaabinaysa Factorial (Isku dhufashada tirooyinka hoos u socda)
hawl xisaabi_faktooriyal(n):
    haddii n <= 1:
        celi 1
    kale:
        celi n * xisaabi_faktooriyal(n - 1)

# Hawl soo saaraysa taxanaha Fibonacci
hawl taxanaha_fibonacci(xaddiga):
    liiska = []
    a, b = 0, 1
    inta dherer(liiska) < xaddiga:
        liiska.append(a)
        a, b = b, a + b
    celi liiska

daabac("=== XISAABTA FAKTOORIYALKA ===")
kasta t ku tirsan(1, 7):
    natiijo = xisaabi_faktooriyal(t)
    daabac(f"Faktooriyalka {t}! waa: {natiijo}")

daabac("\n=== TAXANAHA FIBONACCI ===")
fib = taxanaha_fibonacci(10)
daabac(f"10-ka tiro ee ugu horreeya Fibonacci: {fib}")
