# ==============================================================================
# 🇸🇴 XISAABIYAHA CASRIGA AH EE KOOR (Modern Koor Calculator)
# Luuqadda: Koor
# ==============================================================================

hawl isku_dar(a, b):
    waxaad soo celisaa a + b.

hawl kala_jar(a, b):
    waxaad soo celisaa a - b.

hawl isku_dhufo(a, b):
    waxaad soo celisaa a * b.

hawl qaybi(a, b):
    haddii b == 0:
        waxaad soo saartaa "❌ Khalad: Tiro looma qaybin karo eber (0)!".
        waxaad soo celisaa waxba.
    kale:
        waxaad soo celisaa a / b.

hawl haraa(a, b):
    haddii b == 0:
        waxaad soo saartaa "❌ Khalad: Eber looma heli karo haraa!".
        waxaad soo celisaa waxba.
    kale:
        waxaad soo celisaa a % b.

hawl labajibbaar(a):
    waxaad soo celisaa a * a.

hawl xidid_tiro(a):
    haddii a < 0:
        waxaad soo saartaa "❌ Khalad: Tiro taban ma laha xidid dhab ah!".
        waxaad soo celisaa waxba.
    kale:
        waxaad soo celisaa xidid(a).

# Soo bandhig hordhaca xisaabiyaha
waxaad soo saartaa "==================================================".
waxaad soo saartaa "       🧮 XISAABIYAHA RASMIGA AH EE KOOR         ".
waxaad soo saartaa "==================================================".

soco waa run.

inta soco:
    waxaad soo saartaa "\n--------------------------------------------------".
    waxaad soo saartaa "Dooro hawsha xisaabeed ee aad rabto:".
    waxaad soo saartaa "  1. Isku-dar (+)".
    waxaad soo saartaa "  2. Kala-jar (-)".
    waxaad soo saartaa "  3. Isku-dhufo (*)".
    waxaad soo saartaa "  4. Qaybi (/)".
    waxaad soo saartaa "  5. Haraaga qaybta (%)".
    waxaad soo saartaa "  6. Labajibbaaran (x²)".
    waxaad soo saartaa "  7. Xididka labajibbaaran (√x)".
    waxaad soo saartaa "  8. Ka bax barnaamijka".
    waxaad soo saartaa "--------------------------------------------------".

    doorasho waa waydiin("Geli lambarka hawsha (1-8): ").

    haddii doorasho == "8" ama doorasho == "ka bax":
        waxaad soo saartaa "\n🙏 Waad ku mahadsan tahay isticmaalka Xisaabiyaha Koor!".
        waxaad soo saartaa "Nabad gelyo!".
        soco waa been.
        ka bax.

    # Hawlaha u baahan laba tiro (1, 2, 3, 4, 5)
    haddii doorasho == "1" ama doorasho == "2" ama doorasho == "3" ama doorasho == "4" ama doorasho == "5":
        t1_qoraal waa waydiin("Geli tirada 1aad: ").
        t1 waa tiro(t1_qoraal).
        t2_qoraal waa waydiin("Geli tirada 2aad: ").
        t2 waa tiro(t2_qoraal).

        haddii doorasho == "1":
            jawaab waa isku_dar(t1, t2).
            waxaad soo saartaa "\n✅ Natiijada: {t1} + {t2} = {jawaab}".

        haddii doorasho == "2":
            jawaab waa kala_jar(t1, t2).
            waxaad soo saartaa "\n✅ Natiijada: {t1} - {t2} = {jawaab}".

        haddii doorasho == "3":
            jawaab waa isku_dhufo(t1, t2).
            waxaad soo saartaa "\n✅ Natiijada: {t1} * {t2} = {jawaab}".

        haddii doorasho == "4":
            jawaab waa qaybi(t1, t2).
            haddii jawaab != waxba:
                waxaad soo saartaa "\n✅ Natiijada: {t1} / {t2} = {jawaab}".

        haddii doorasho == "5":
            jawaab waa haraa(t1, t2).
            haddii jawaab != waxba:
                waxaad soo saartaa "\n✅ Natiijada: {t1} % {t2} = {jawaab}".

    haddii kale doorasho == "6":
        t_qoraal waa waydiin("Geli tirada: ").
        t waa tiro(t_qoraal).
        jawaab waa labajibbaar(t).
        waxaad soo saartaa "\n✅ Natiijada: {t}² = {jawaab}".

    haddii kale doorasho == "7":
        t_qoraal waa waydiin("Geli tirada: ").
        t waa tiro(t_qoraal).
        jawaab waa xidid_tiro(t).
        haddii jawaab != waxba:
            waxaad soo saartaa "\n✅ Natiijada: √{t} = {jawaab}".

    kale:
        waxaad soo saartaa "\n⚠️ Fadlan dooro lambar sax ah oo u dhexeeya 1 iyo 8!".
