# ==============================================================================
# 🇸🇴 DIIWAANKA DHAMMAAN HABABKA EE LUUQADDA KOOR (The Master Koor Showcase)
# Faylkani waxa uu soo bandhigayaa dhammaan qaababka iyo fursadaha luuqadda Koor:
# 1. Doorsoomayaasha & Noocyada Xogta (Variables & Types)
# 2. Xisaabiyayaasha (Natural Zero-Signs & Classic Math)
# 3. Hawlaha (Structured, Classic, Zero-Signs & Wicitaankooda)
# 4. Xakameynta Socodka (Shuruudaha & Wareegyada)
# 5. Qaababka Xogta (Liisaska, Qaamuusyada, Qoraalka)
# 6. Gelinta & Soo Saarista (Input & Output)
# ==============================================================================

soo saar "=================================================="
soo saar "     🌟 1. DOORSOOMAYAASHA & NOOCYADA XOGTA       "
soo saar "=================================================="

# A. Qoraal saafi ah (Zero Signs)
magac waa "Aamina"
da' waa 20
qiimo waa 45.5
waa_arday waa run
waxba_laguma_hayn waa waxba

soo saar "Magaca: {magac}, Da'da: {da'}, Arday ma yahay: {waa_arday}"
soo saar "Nooca doorsoomaha 'da'' waa:", nooc da'

# B. Wax ka beddelka doorsoomaha (In-place mutation)
da' waxaad ku dartaa 5
da' waxaad ka jartaa 2
da' waxaad ku dhufataa 2
da' waxaad u qaybisaa 4
soo saar "Da'da cusub ka dib xisaabinta waa: {da'}"


soo saar "\n=================================================="
soo saar "     ➕ 2. XISAABTA (ZERO-SIGNS IYO CAADIGA AH)     "
soo saar "=================================================="

# A. Xisaabta bilaa calaamadda ah (Natural Zero-Signs Math)
k1 waa 10 ku dar 5
k2 waa 20 ka jar 8
k3 waa 6 ku dhufo 7
k4 waa 30 u qaybi 5
k5 waa 17 haraaga 5

soo saar "Zero-Signs Math:"
soo saar "  10 ku dar 5 =", k1
soo saar "  20 ka jar 8 =", k2
soo saar "  6 ku dhufo 7 =", k3
soo saar "  30 u qaybi 5 =", k4
soo saar "  17 haraaga 5 =", k5

# B. Xisaabta calaamadaha leh (Classic Math)
c_xisaab waa (10 + 5) * 2 - (20 / 4)
soo saar "Classic Math (10 + 5) * 2 - (20 / 4) =", c_xisaab


soo saar "\n=================================================="
soo saar "     ⚙️ 3. HAWLAHA (FUNCTIONS) IYO WICITAANKOODA  "
soo saar "=================================================="

# QAABKA 1: Hawsha Habaysan ee Cusub (Structured Declarative Style)
hawl
magaceed waa : isku_dhufasho
tibxuhu waa : x , y
hawshu waa : x ku dhufo y
kaydi natiijada

# QAABKA 2: Hawl bilaa barxado ah (Zero-Argument Function)
hawl
magaceed waa : salaan
hawshu waa : soo saar "Ku soo dhawoow dunida Koor!"

# QAABKA 3: Hawsha Bilaa Calaamadda ah (Pure Zero-Signs Block)
hawl kala_goo x y
    waxaad soo celisaa x ka jar y
    kaydi natiijada

# QAABKA 4: Hawsha Caadiga ah (Classic Block with Parens)
hawl isku_dar(a, b):
    waxaad soo celisaa a + b.

# QAABKA 5: Hawsha Toosan (Natural Inline Function)
hawshu waa ("labanlaab")
(n * 2)

# --- HABABKA KALA DUWAN EE LOO WICO HAWLAHA (CALLING FUNCTIONS) ---

# Habka 1: Qaabka Rasmiga ah ee 'qabo hawshan' (Function Calling Syntax)
# A. Hawl bilaa barxado ah (ma laha qaws labaad):
qabo hawshan (salaan)

# B. Hawl leh barxado (qaws labaad oo leh qiimayaasha):
jawaab_qabo waa qabo hawshan (isku_dhufasho) (6, 7)
soo saar "Qabo hawshan (isku_dhufasho) (6, 7): {jawaab_qabo}"

jawaab_qabo2 waa qabo hawshan (kala_goo) (50, 20)
soo saar "Qabo hawshan (kala_goo) (50, 20): {jawaab_qabo2}"

# Habka 2: Wicitaan toos ah bilaa calaamad ah
jawaab_a waa isku_dhufasho 6 7
soo saar "Wicitaan toos ah (isku_dhufasho 6 7): {jawaab_a}"

# Habka 3: Adoo adeegsanaya 'iyo'
jawaab_b waa kala_goo 50 iyo 20
soo saar "Wicitaan iyo leh (kala_goo 50 iyo 20): {jawaab_b}"

# Habka 4: Wicitaanka caadiga ah leh qawska ()
jawaab_d waa isku_dar(15, 25)
soo saar "Wicitaan caadi ah (isku_dar(15, 25)): {jawaab_d}"


soo saar "\n=================================================="
soo saar "     🔀 4. SHURUUDAHA (CONDITIONALS)               "
soo saar "=================================================="

dhibco waa 85

# Shuruudaha dabiiciga ah ee bilaa calaamadda ah:
haddii dhibco ka weyn yahay ama la mid yahay 90
    soo saar "Darajada: A (Heer Sare)"
haddii kale oo ay dhibco ka weyn yahay ama la mid yahay 80
    soo saar "Darajada: B (Aad u Wanaagsan)"
kale
    soo saar "Darajada: C (Dadaal Dheeraad ah)"

# Shardi toosan hal sadar ah (Inline conditional):
haddii dhibco ay la mid tahay 85 waxaad soo saartaa "Xaqiijin: Dhibcuhu waa sax 85!"


soo saar "\n=================================================="
soo saar "     🔄 5. WAREEGYADA (LOOPS)                      "
soo saar "=================================================="

# A. Ku celi N jeer (Repeat Loop - Zero Signs)
soo saar "--- Ku celi 3 jeer ---"
ku celi 3 jeer
    soo saar "Salaan Dunida Koor!"

# B. Wareegga 'inta' (While Loop)
soo saar "--- Wareegga 'inta' ---"
tirsade waa 1
inta tirsade ka yar yahay ama la mid yahay 3
    soo saar "Tirsade waa: {tirsade}"
    waxaad 1 ku dartaa tirsade

# C. Wareegga 'mid kastoo' (For-Each Loop)
soo saar "--- Wareegga 'mid kastoo' ---"
ardayda waa liiska "Cali" iyo "Aamina" iyo "Warsame"
mid kastoo ku jira (qof)
    soo saar "Ku soo dhawoow {qof}!"


soo saar "\n=================================================="
soo saar "     📦 6. QAABABKA XOGTA (DATA STRUCTURES)        "
soo saar "=================================================="

# A. Liisaska (Lists):
liis_cusub waa liiska 10 iyo 20 iyo 30
liis_cusub.ku_dar(40)
soo saar "Liiska: {liis_cusub}, Dhererka:", dherer liis_cusub

# B. Qaamuusyada (Dictionaries):
arday waa {
    "magac": "Faadumo",
    "da'": 21,
    "magaalo": "Muqdisho"
}
soo saar "Ardayga magaciisa:", arday["magac"]
soo saar "Ardayga magaaladiisa:", arday["magaalo"]

# C. Qoraalka (String Methods):
hadal waa "   soomaaliya ha noolaato   "
soo saar "Qoraal la safeeyey oo la weyneeyey:", hadal.jar().weyneey()

soo saar "\n=================================================="
soo saar "  🎉 DHAMMAAN HABABKA KOOR WAXAY U SHAQEYNAYAAN 100%! "
soo saar "=================================================="
