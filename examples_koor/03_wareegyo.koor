# 🇸🇴 Wareegyada (Loops) ee Koor

# 1. Ku celi N jeer
waxaad soo saartaa "--- Wareegga 'ku celi': ---"
ku celi 3 jeer:
    waxaad soo saartaa "Kani waa wareeg toos ah!"

# 2. Wareegga 'inta' (While loop)
waxaad soo saartaa "\n--- Wareegga 'inta': ---"
tirsade waa 1.
inta tirsade <= 5:
    waxaad soo saartaa "Tiradu waa {tirsade}."
    waxaad ku dartaa 1 tirsade.

# 3. Wareegga 'mid kastoo' (For each item)
waxaad soo saartaa "\n--- Wareegga 'mid kastoo': ---"
ardayda waa ["Faadumo", "Cali", "Warsame", "Deeqa"].
mid kastoo ku jira ardayda ( arday ):
    waxaad soo saartaa "Ku soo dhawoow dugsiga, {arday}!"
